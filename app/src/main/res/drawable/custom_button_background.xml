<?xml version="1.0" encoding="utf-8"?>
<!--
    Custom theme push-button background: an outlined pill, never filled, with
    the background showing through and a 1.25dp accent frame. Pressing shows a
    ripple inside the pill; disabled dims the frame. The padding insets the
    label from the frame. This is what a button gets from the theme; buttons
    inflated through AppCompatViewInflaterEx are redrawn by Pills.apply, which
    also follows the colour overrides and knows the main button of a dialog.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFFFF00">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1.25dp" android:color="#61FFFF00" />
                    <corners android:radius="100dp" />
                    <padding android:left="16dp" android:top="8dp" android:right="16dp" android:bottom="8dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="1.25dp" android:color="@color/customColorAccent" />
                    <corners android:radius="100dp" />
                    <padding android:left="16dp" android:top="8dp" android:right="16dp" android:bottom="8dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
