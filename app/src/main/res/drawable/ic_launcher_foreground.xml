<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <!--
    Black-yellow fork icon: a yellow line-traced envelope on the black
    background drawable. 75% of the visible (72dp) masked icon wide,
    landscape 1.3:1, centred in the 108dp canvas. Stroke is 3.4% and the
    corner radius 5% of the visible icon; the flap tip reaches 68.6% of
    the envelope height. No android:tint here - the yellow strokeColor
    must win. The flap uses butt caps (round caps poke past the corners)
    and is drawn BEFORE the body, so the body top edge paints over the
    flap ends and nothing rises above the envelope.
  -->
  <!-- flap V crease, under the body -->
  <path
      android:strokeColor="#FFFF00"
      android:strokeWidth="2.448"
      android:strokeLineCap="butt"
      android:strokeLineJoin="round"
      android:fillColor="#00000000"
      android:pathData="M30.6,33.231 L54,61.726 L77.4,33.231" />
  <!-- envelope body: rounded-rectangle outline, on top -->
  <path
      android:strokeColor="#FFFF00"
      android:strokeWidth="2.448"
      android:strokeLineCap="butt"
      android:strokeLineJoin="round"
      android:fillColor="#00000000"
      android:pathData="M30.6,33.231 L77.4,33.231 A3.6,3.6 0 0 1 81,36.831 L81,71.169 A3.6,3.6 0 0 1 77.4,74.769 L30.6,74.769 A3.6,3.6 0 0 1 27,71.169 L27,36.831 A3.6,3.6 0 0 1 30.6,33.231 Z" />
</vector>
